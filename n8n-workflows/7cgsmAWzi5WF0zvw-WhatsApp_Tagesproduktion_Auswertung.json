        304
      ],
      "webhookId": "0bbbf491-8730-44e2-82a6-675a4231a9af"
    },
    {
      "parameters": {
        "text": "={{ $json['WhatsApp Text'] }}",
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"eintraege\": [\n    {\n      \"datum\": \"2026-08-03\",\n      \"vertriebspartner\": \"Max Mustermann\",\n      \"neukunden\": 2,\n      \"bestandskunden\": 1,\n      \"zeitslot\": \"09-12\",\n      \"rohzeile\": \"Max: 2 NK, 1 BK, 9-12 Uhr\"\n    }\n  ]\n}",
        "options": {
          "systemPromptTemplate": "=Du unterstützt einen Door-to-Door-Vertrieb (weeenergie) bei der Auswertung der WhatsApp-Tagesproduktion.\nVertriebspartner melden dort ihre Produktion in Kurzform, z.B. \"NEW 4\", \"UP! 2\", \"2 NK, 1 BK\" o.ä.\n\nBegriffe:\n- NEW / NK / Neukunde = Neukunde\n- UP! / UP / BK / Bestandskunde = Bestandskunde (Upgrade)\n\nErzeuge für JEDE einzelne Meldung/Zeile im eingefügten Text einen eigenen Eintrag im Array 'eintraege'. Falls der Text im WhatsApp-Exportformat vorliegt (z.B. \"27.07.26, 15:03 - Nico Weeenergie: UP! 2\"), nutze Datum, Uhrzeit und Absendername aus dieser Zeile:\n- datum: Format YYYY-MM-DD. Steht kein Datum im Text, verwende {{ $now.toFormat('yyyy-MM-dd') }}.\n- vertriebspartner: Name des Absenders/der Person.\n- neukunden: Anzahl Neukunden als Zahl, 0 falls keine Angabe.\n- bestandskunden: Anzahl Bestandskunden als Zahl, 0 falls keine Angabe.\n- zeitslot: eines von '09-12', '13-16', '17-20' oder 'unbekannt' - ordne die genannte Uhrzeit dem nächstliegenden Zeitfenster zu.\n- rohzeile: die ursprüngliche Zeile/Meldung unverändert, zur Nachvollziehbarkeit.\n\nGib ausschließlich das JSON-Objekt zurück."
        }
      },
      "id": "8a498790-e409-4287-9752-21a5a6d0e059",
