  "name": "WhatsApp Tagesproduktion Auswertung",
  "nodes": [
    {
      "parameters": {
        "formTitle": "WhatsApp Tagesproduktion auswerten",
        "formDescription": "Kopiere die WhatsApp-Meldungen der Tagesproduktion (eine oder mehrere Personen) und füge sie unten ein.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "WhatsApp Text",
              "fieldType": "textarea",
              "placeholder": "z.B.\nMax: 2 NK, 1 BK, 9-12 Uhr\nAnna: 3 NK, 13-16 Uhr",
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Auswerten",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Danke! Die Daten werden ausgewertet und in Google Sheets gespeichert."
            }
          }
        }
      },
      "id": "0361dbe7-9328-4bbc-8e74-7f3775cef4cb",
